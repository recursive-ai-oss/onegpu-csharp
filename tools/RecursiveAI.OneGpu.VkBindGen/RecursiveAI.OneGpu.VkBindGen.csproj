<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool: turns the Khronos registry (vk.xml) into src/RecursiveAI.OneGpu.Vulkan/Interop/VulkanApi.g.cs. Nothing here ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneGpu.VkBindGen</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
