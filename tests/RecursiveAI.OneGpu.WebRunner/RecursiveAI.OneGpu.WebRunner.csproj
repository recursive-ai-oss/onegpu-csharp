<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    Runs the backend-neutral graphics tests of RecursiveAI.OneGpu.Vulkan.Tests in a browser on WebGPU. The test sources are shared
    with that project; this one supplies the device, the golden images and a small runner. Test code only: nothing here ships.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OneGpu.Vulkan.Tests</RootNamespace>
    <AssemblyName>RecursiveAI.OneGpu.WebRunner</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);WEB_BACKEND</DefineConstants>
    <!-- The runner finds tests by reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <OneShaderNamespace>RecursiveAI.OneGpu.Vulkan.Tests.Shaders</OneShaderNamespace>
    <EnableDefaultOneShaderItems>false</EnableDefaultOneShaderItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <Shared>$(MSBuildThisFileDirectory)../RecursiveAI.OneGpu.Vulkan.Tests/</Shared>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../RecursiveAI.OneGpu.Kernels.Tests/GemmTests.cs;../RecursiveAI.OneGpu.Kernels.Tests/GemmRunner.cs;../RecursiveAI.OneGpu.Kernels.Tests/GemmReference.cs" />
    <Compile Include="$(Shared)FeatureTests.cs;$(Shared)ComputeTests.cs;$(Shared)RenderTests.cs;$(Shared)Png.cs;$(Shared)ReadHelpers.cs" />
    <OneShader Include="$(Shared)Shaders/*.hlsl" Exclude="$(Shared)Shaders/TextureArray.hlsl" Targets="SpirV;Msl;Wgsl" />
    <EmbeddedResource Include="../../testdata/gpu/*.png" LogicalName="golden/%(Filename)%(Extension)" />
    <Content Include="../../src/RecursiveAI.OneGpu.WebGpu/js/onegpu.js" Link="wwwroot/onegpu.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneShader.Build" />
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <ProjectReference Include="../../src/RecursiveAI.OneGpu/RecursiveAI.OneGpu.csproj" />
    <ProjectReference Include="../../src/RecursiveAI.OneGpu.WebGpu/RecursiveAI.OneGpu.WebGpu.csproj" />
    <ProjectReference Include="../../src/RecursiveAI.OneGpu.Kernels/RecursiveAI.OneGpu.Kernels.csproj" />
  </ItemGroup>

</Project>
