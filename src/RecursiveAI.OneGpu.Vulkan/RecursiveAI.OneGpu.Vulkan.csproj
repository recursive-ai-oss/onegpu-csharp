<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Vulkan backend of the GPU layer.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The one place native interop lives for graphics: blittable structs and function pointers into the Vulkan loader. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RecursiveAI.OneGpu/RecursiveAI.OneGpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneGpu.Vulkan.Tests" />
  </ItemGroup>

</Project>
