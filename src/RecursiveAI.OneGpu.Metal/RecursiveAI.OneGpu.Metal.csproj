<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Metal backend of the GPU layer.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native interop for Metal: blittable structs and function-pointer calls into the Objective-C runtime. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RecursiveAI.OneGpu/RecursiveAI.OneGpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneGpu.Vulkan.Tests" />
  </ItemGroup>

</Project>
