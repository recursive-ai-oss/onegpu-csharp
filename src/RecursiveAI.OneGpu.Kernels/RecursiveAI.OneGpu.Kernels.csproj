<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Compute kernels for machine-learning inference, written in HLSL and compiled for Vulkan, Metal and WebGPU.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <OneShaderNamespace>RecursiveAI.OneGpu.Kernels.Shaders</OneShaderNamespace>
    <EnableDefaultOneShaderItems>false</EnableDefaultOneShaderItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only: the compiler and the binding generator never reach a consumer. -->
    <PackageReference Include="RecursiveAI.OneShader.Build" PrivateAssets="all" />
    <ProjectReference Include="../RecursiveAI.OneGpu/RecursiveAI.OneGpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <OneShader Include="Shaders/ArgReduce.hlsl" Axes="F16" />
    <OneShader Include="Shaders/Attention.hlsl" Axes="F16;WAVE;ACC;VEC4;HD=D32|D64|D128|D256" Targets="SpirV;Msl;Wgsl" />
    <OneShader Include="Shaders/AttentionCoop.hlsl" Axes="BF16;HD=D32|D64|D128" Targets="SpirV" Enable16BitTypes="true" />
    <OneShader Include="Shaders/AttentionSimd.hlsl" Axes="ELEM=F16|BF16|F32;HD=D32|D64|D128;QD" Targets="Msl" Enable16BitTypes="true" />
    <OneShader Include="Shaders/AttentionLoops.hlsl" Axes="F16;WAVE;ACC;HD=D32|D64|D128|D256" Targets="Wgsl" />
    <OneShader Include="Shaders/AttentionCombine.hlsl" Axes="F16;BF16" />
    <OneShader Include="Shaders/Binary.hlsl" Axes="F16;ACT;RANK=R1|R2|RN" />
    <OneShader Include="Shaders/Cast.hlsl" />
    <OneShader Include="Shaders/Col2Im.hlsl" Axes="F16" />
    <OneShader Include="Shaders/ConvEpilogue.hlsl" Axes="F16;SPLIT" />
    <OneShader Include="Shaders/ConvGemm.hlsl" Axes="F16" />
    <OneShader Include="Shaders/ConvIntegerPack.hlsl" />
    <OneShader Include="Shaders/ConvCoopF32.hlsl" Targets="Msl" />
    <OneShader Include="Shaders/ConvCoopNarrowF32.hlsl" Targets="Msl" />
    <OneShader Include="Shaders/DepthwiseConv.hlsl" Axes="F16" />
    <OneShader Include="Shaders/GlobalPool.hlsl" Axes="F16" />
    <OneShader Include="Shaders/Im2Col.hlsl" Axes="F16" />
    <OneShader Include="Shaders/Pool.hlsl" Axes="F16" />
    <OneShader Include="Shaders/Resize.hlsl" Axes="F16" />
    <OneShader Include="Shaders/Concat.hlsl" Axes="ELEM=W16|W32|W64" />
    <OneShader Include="Shaders/Generate.hlsl" />
    <OneShader Include="Shaders/Integer.hlsl" />
    <OneShader Include="Shaders/Compare.hlsl" Axes="F16;RANK=R1|R2|RN" />
    <OneShader Include="Shaders/Dequantize.hlsl" Axes="KIND=U8|I8|I32;F16" />
    <OneShader Include="Shaders/DynamicQuantize.hlsl" />
    <OneShader Include="Shaders/Gather.hlsl" Axes="ELEM=W8|W16|W32|W64" />
    <OneShader Include="Shaders/GatherElements.hlsl" Axes="ELEM=W8|W16|W32|W64" />
    <OneShader Include="Shaders/GatherNd.hlsl" Axes="ELEM=W8|W16|W32|W64" />
    <OneShader Include="Shaders/Int8Epilogue.hlsl" />
    <OneShader Include="Shaders/Quantize.hlsl" Axes="SIGNED;F16" />
    <OneShader Include="Shaders/RecurrentInit.hlsl" Axes="F16" />
    <OneShader Include="Shaders/RecurrentOutputs.hlsl" Axes="F16" />
    <OneShader Include="Shaders/RecurrentStep.hlsl" Axes="F16;SMALL;STD;CELL=LSTM|GRU|RNN" />
    <OneShader Include="Shaders/Int8GemmDot.hlsl" Axes="SMALL" />
    <OneShader Include="Shaders/Int8GemmKernel.hlsl" />
    <OneShader Include="Shaders/Norm.hlsl" Axes="F16;WAVE" />
    <OneShader Include="Shaders/Reduce.hlsl" Axes="F16;WAVE;RRANK=R1|RN" />
    <OneShader Include="Shaders/ScatterElements.hlsl" Axes="ELEM=W16|W32|W64" />
    <OneShader Include="Shaders/ScatterNd.hlsl" Axes="ELEM=W16|W32|W64" />
    <OneShader Include="Shaders/Softmax.hlsl" Axes="F16;WAVE" />
    <OneShader Include="Shaders/Transpose.hlsl" Axes="ELEM=W16|W32|W64" />
    <OneShader Include="Shaders/Unary.hlsl" Axes="F16" />
    <OneShader Include="Shaders/Where.hlsl" Axes="F16" />
    <OneShader Include="Shaders/GemmF32.hlsl" />
    <OneShader Include="Shaders/GemmF16.hlsl" />
    <OneShader Include="Shaders/GemmBF16.hlsl" />
    <OneShader Include="Shaders/GemmCoopF32.hlsl" Targets="Msl" />
    <OneShader Include="Shaders/GemmCoopWideF32.hlsl" Targets="Msl" />
    <OneShader Include="Shaders/GemmCoopF16.hlsl" Targets="SpirV;Msl" Enable16BitTypes="true" />
    <OneShader Include="Shaders/GemmCoopBF16.hlsl" Targets="SpirV;Msl" Enable16BitTypes="true" />
    <OneShader Include="Shaders/GemmCoopWideF16.hlsl" Targets="SpirV;Msl" Enable16BitTypes="true" />
    <OneShader Include="Shaders/GemmCoopWideBF16.hlsl" Targets="SpirV;Msl" Enable16BitTypes="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneGpu.Kernels.Tests" />
    <InternalsVisibleTo Include="RecursiveAI.OneGpu.WebRunner" />
  </ItemGroup>

</Project>
