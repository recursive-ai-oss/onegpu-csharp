<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>WebGPU backend for onegpu in the browser (.NET WebAssembly).</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Source-generated JavaScript interop (JSImport) is the browser's counterpart of LibraryImport and needs unsafe code in the generated stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RecursiveAI.OneGpu/RecursiveAI.OneGpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser half of the backend. It ships as a static web asset, so an app that references the package publishes it at
         _content/RecursiveAI.OneGpu.WebGpu/onegpu.js without copying anything by hand. -->
    <!-- (the default wwwroot/** glob of the Razor SDK picks wwwroot/onegpu.js up) -->
  </ItemGroup>

</Project>
